// Copyright (c) 2026 Sentieon Inc. All rights reserved
// Local profile: runs INGEST_BATCH (then REGISTER + AGGREGATE + INDEX and
// MAINTAIN) directly on the host machine, no container, against the
// docker-compose stack in iceberg_test/. The full ingest -> register ->
// aggregate -> {index, maintain} flow runs in one `nextflow run`; only
// `mosaic init` is a manual prerequisite.
//
// Pre-reqs:
//   cd iceberg_test && docker-compose up -d && cd ..
//   mosaic init <reference-sample.gvcf.gz> --chromosomes chr21
//
// The default MOSAIC_* env vars in config.py already point at the local
// Docker services, so no environment setup is needed. If you want to
// override (e.g. point at a different Postgres), export MOSAIC_* before
// invoking Nextflow and they'll be inherited.
//
// Full local multi-tier test (downloads 1000G gVCFs from S3, processes
// locally; 4 batches with --fan_in 2 forces a 2-tier aggregate merge):
//   printf 'HG00096\nHG00097\nHG00099\nHG00100\n' > samples.txt
//   nextflow run workflow/main.nf -profile local \
//       --samples samples.txt --region chr21 --batch_size 1 --fan_in 2
//
// The joint-call workflow (joint_call.nf) runs under this profile too, one
// task per process at a time (the joint_call_export_forks and
// joint_call_max_forks parameters are not applied here); its VCFs go to
// ./joint_calls/gen<agg_run_id>/ by default:
//   nextflow run workflow/joint_call.nf -profile local \
//       --samples samples.txt --batch_size 2 --region chr21

process {
    executor  = 'local'
    container = null
    cpus      = { Math.min(8, Runtime.runtime.availableProcessors()) }
    memory    = 16.GB
    disk      = 100.GB

    // Run one batch at a time on a laptop. Bump if you have a
    // workstation and an idle local Postgres.
    maxForks  = 1

    // nextflow.config's jc_export_contig / jc_call selectors set
    // EXPORT_CONTIG's and JOINT_CALL's maxForks (joint_call_export_forks /
    // joint_call_max_forks); these later ones keep them at one at a time.
    withLabel: 'jc_export_contig|jc_call' {
        maxForks = 1
    }
}

docker.enabled    = false
singularity.enabled = false

workDir = './work'
