// Copyright (c) 2026 Sentieon Inc. All rights reserved
// AWS Batch profile: runs INGEST_BATCH as AWS Batch jobs, with staging
// via an S3 work dir. After all ingest jobs finish, a single REGISTER job
// (registers the deferred batches' files with Iceberg), then AGGREGATE, then
// INDEX and MAINTAIN (Iceberg maintenance; independent of each other) run
// in-graph. AGGREGATE has a `withName` block below whose
// cpus/memory come from params.aggregate_cpus / params.aggregate_memory
// (default 4 vCPU / 12 GiB, matching the shared CE). Its reduce memory scales
// with params.aggregate_threads (at 3,202
// samples genome-wide only 1 thread fit in 12 GB). Raise aggregate_memory for a very large cohort
// ONLY alongside a compute environment with a matching instance type — an
// oversized request strands the job in RUNNABLE with
// MISCONFIGURATION:JOB_RESOURCE_REQUIREMENT.
//
// Pre-reqs (see README.md for details):
//   - RDS instance running; DB password stored in
//     AWS Secrets Manager at 'mosaic/db-password'. Size its volume for the
//     aggregate's finalize (the 3,202-sample genome-wide run needed
//     >= 200 GiB, peak ~164 GB used) or enable storage autoscaling
//     (MaxAllocatedStorage) so a full disk grows instead of killing the run
//   - S3 bucket for the Iceberg warehouse AND the Nextflow workdir
//   - Batch compute environment + queue 'mosaic-ingest-queue'
//   - ECR image pushed — see Dockerfile + README
//   - Batch compute env IAM role grants: s3:GetObject on
//     1000genomes-dragen-v4-2-7, s3:* on your warehouse bucket, glue:*,
//     and secretsmanager:GetSecretValue on mosaic/db-password
//   - `mosaic init` already run against RDS with the desired chromosome
//     scope (the one manual step; register + aggregate + index + maintain
//     run in-graph after ingest)
//
// The joint-call workflow (joint_call.nf) runs under this profile too, after
// the ingestion run: COHORT_STATE, EXPORT_COHORT, EXPORT_CONTIG (at most
// params.joint_call_export_forks at a time), JOINT_CALL per set x chromosome
// (cpus / memory from params.joint_call_cpus / joint_call_memory, at most
// params.joint_call_max_forks at a time when set, else maxForks below) and
// JOINT_CALL_SUMMARY; its outputs go to params.joint_call_out (below). The
// image carries joint_call.py and joint_call_task.py in /opt/mosaic/bin.
//
// Override container/queue via `-c user.config` or `--container` if
// you built a different image tag.

params {
    // ECR image URI for the pipeline worker. Override via --container
    // on the nextflow CLI or an -c override file.
    container       = '<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/mosaic:latest'
    batch_queue     = 'mosaic-ingest-queue'
    aws_region      = 'us-east-1'
    s3_bucket       = 'my-warehouse-bucket'
    rds_host        = 'my-db.xxxxxxxx.us-east-1.rds.amazonaws.com'
}

process {
    executor  = 'awsbatch'
    queue     = params.batch_queue
    container = params.container

    // 30 is what the 3,202-sample genome-wide run used (July 2026): 30
    // concurrent writers averaged 2.7 Iceberg commit retries per task, all
    // succeeding on the second attempt. With deferred registration (the
    // default since D2) an ingest task makes no Iceberg commit at all, and
    // since D1 it holds one PostgreSQL connection (the shard workers open
    // none), so the caps left are the RDS connection limit and the download
    // bandwidth. Bump after monitoring pg_stat_activity.
    maxForks  = 30

    // Retry on OOM / SIGTERM / SIGKILL (spot interrupts manifest as
    // 137/143), then fall back to general retry.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry'
                      : (task.attempt <= 3 ? 'retry' : 'finish') }

    // AGGREGATE resources. Defaults are identical to the shared 4 vCPU / 12 GiB
    // above, so AGGREGATE fits the existing compute environment out of the box;
    // lower params.aggregate_threads to stay under that cap on a large cohort
    // (1 thread was needed at 3,202 samples genome-wide). Raise params.aggregate_memory (e.g. 32.GB) only
    // together with a queue whose CE has matching instances, else the job
    // strands in RUNNABLE (see the header note).
    withName: AGGREGATE {
        cpus   = params.aggregate_cpus
        memory = params.aggregate_memory
    }
}

aws {
    region = params.aws_region
    batch {
        // AWS CLI v2 inside the container — must match the path in
        // the Dockerfile's install step.
        maxParallelTransfers = 16
        jobRole              = 'arn:aws:iam::<AWS_ACCOUNT_ID>:role/mosaic-batch-job-role'
    }
}

// Nextflow stages task inputs/outputs + .command.sh through this URL.
// Real gVCF downloads go directly to container ephemeral disk,
// not through this prefix.
workDir = "s3://${params.s3_bucket}/nextflow-work/"

// Keep work dirs around during bring-up so failed tasks can be
// inspected in S3. Flip to true after the pipeline is stable.
cleanup = false

// Publish per-batch logs to S3 so we don't have to fetch them from
// the Nextflow workdir manually.
params.log_dir = "s3://${params.s3_bucket}/nextflow-logs/"
// The joint-call workflow's outputs (<prefix>/gen<agg_run_id>/...).
params.joint_call_out = "s3://${params.s3_bucket}/joint-calls/"

// MOSAIC_* environment variables for every task. `MOSAIC_DB_PASSWORD` is
// deliberately NOT set here — each process wrapper (fetch_and_ingest.py for
// ingest, with_db_password.py for register/aggregate/index/maintain) pulls
// it from AWS Secrets Manager at task start, which keeps the secret out of
// Nextflow's config dump and task env printouts.
env {
    MOSAIC_DB_HOST           = params.rds_host
    MOSAIC_DB_NAME           = 'postgres'
    MOSAIC_DB_USER           = 'postgres'
    MOSAIC_DB_PORT           = '5432'
    MOSAIC_DB_SSLMODE        = 'require'
    MOSAIC_DB_SSLCERT        = '/opt/global-bundle.pem'
    MOSAIC_ICEBERG_TYPE      = 'glue'
    MOSAIC_WAREHOUSE         = "s3://${params.s3_bucket}/"
    MOSAIC_S3_BUCKET         = params.s3_bucket
    MOSAIC_S3_REGION         = params.aws_region
    MOSAIC_ICEBERG_NAMESPACE = 'mosaic'
    AWS_REGION               = params.aws_region
    AWS_DEFAULT_REGION       = params.aws_region
    // Name of the Secrets Manager secret holding the RDS password.
    // The process wrappers read this at task start.
    MOSAIC_DB_PASSWORD_SECRET = 'mosaic/db-password'
}
