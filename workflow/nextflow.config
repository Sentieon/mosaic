// Copyright (c) 2026 Sentieon Inc. All rights reserved
// Top-level Nextflow config for the MOSAIC ingestion pipeline (main.nf) and
// the joint-call workflow (joint_call.nf), which share it.
//
// Per-executor settings live in conf/*.config and are selected via
// `-profile local` or `-profile awsbatch`.

manifest {
    name        = 'mosaic-ingest'
    description = 'Fan-out ingestion of 1000G gVCFs into Postgres + Iceberg'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version     = '0.1.0'
}

params {
    // Required: path to a newline-delimited file of sample names
    // (HG00096, HG00097, ...). Lines starting with # and blank lines
    // are skipped. For awsbatch, this can be an s3:// URL.
    samples         = null

    // How many samples one INGEST_BATCH task processes.
    batch_size      = 200

    // Passed through to `mosaic ingest`. pos_batch_size 100_000 is what the
    // 3,202-sample genome-wide run completed with (July 2026); a shard
    // worker's peak memory tracks it (13.5 GB in a 12 GB task on
    // chr1/2/4/6/X then; E1 lowered it, unmeasured at that scale since).
    shard_size      = 500_000
    pos_batch_size  = 100_000

    // Ref-block banding (`mosaic ingest --ref-gq-bands`). null (the
    // default) = off: every ref block stored as the gVCF has it. A spec
    // ('20,60': the GQ bands [0,20), [20,60), [60,99]; 'all': one band)
    // stores a sample's adjacent ref blocks of the same GT class and GQ band
    // within one pos_batch_size window as one sample_ref_blocks row (dp the
    // length-weighted mean, AD / PL of the lowest-GQ block): fewer
    // per-sample rows and bytes; changes INFO/DP and the FORMAT DP / AD / PL
    // of ref-filled samples, not AN, the genotype matrix or sample_qc. Recorded
    // per batch in ingestion_progress.ref_gq_bands; a resumed batch must use
    // the same value, so do not change it between a failed run and its
    // -resume.
    ref_gq_bands    = null

    // Thread count for downloads + ingestion. null = task.cpus
    ingest_threads  = null

    // Optional region filter for bcftools (e.g. 'chr21'). null = whole
    // genome. Useful for smoke tests against a subset of the data.
    region          = null

    // Where INGEST_BATCH logs are published. Override to an s3:// URL
    // on awsbatch runs.
    log_dir         = './logs'

    // Deferred Iceberg registration (the scaling path). true: each
    // INGEST_BATCH runs `mosaic ingest --defer-register` (uploads its Parquet,
    // records the file list in PostgreSQL ingest_files, leaves the batch
    // 'uploaded') and the REGISTER step registers every batch's files with
    // one committer per table, then completes the batches. false: each task
    // commits to the six shared Iceberg tables itself (inline, the `mosaic
    // ingest` default) and REGISTER reports nothing to register.
    defer_register  = true
    // `mosaic register --files-per-commit`: data files per Iceberg commit
    // (min 1).
    register_files_per_commit = 500

    // Iceberg maintenance (`mosaic maintain`): a MAINTAIN step after
    // AGGREGATE, alongside INDEX, that rewrites each table's manifests,
    // expires the old snapshots and deletes the files only they needed (among
    // them the staging AGGREGATE's completion pruned). false skips it.
    maintain                    = true
    // `mosaic maintain --older-than-hours`: snapshots younger than this are
    // retained. 0 = by count only (each table keeps its current snapshot), so
    // the aggregate's pruned staging is reclaimed in the same run; safe here
    // because the pipeline serializes every reader and writer (nothing reads
    // an older snapshot while MAINTAIN runs). The CLI default, 120 (five
    // days), protects a reader started by hand.
    maintain_older_than_hours   = 0
    // `--orphans`: also delete the objects under the upload prefixes and the
    // table locations that no snapshot of any table in the catalog references
    // (uploads of a crashed ingest never resumed, metadata.json versions from
    // before the delete-after-commit property). Opt-in: it reads every
    // namespace of the catalog and assumes those prefixes belong to it.
    maintain_orphans            = false
    // `--orphan-grace-hours`: with maintain_orphans, objects modified within
    // this many hours are kept (an upload whose commit may still come).
    maintain_orphan_grace_hours = 72

    // Batches merged per tier in `mosaic aggregate` (the tier-tree
    // fan-in). >= total #batches => single pass (1 tier); smaller => more
    // tiers. Min 2; 100 matches the `mosaic aggregate` CLI default.
    fan_in          = 100

    // --- AGGREGATE tuning ---
    // The finalize streams in chunks, and each reduce worker's accumulator is
    // bounded by output keys (sites/alleles per chromosome), not input rows.
    // Peak memory is still ~aggregate_threads x per-chromosome key count:
    // at 3,202 samples genome-wide, 4 threads OOM'd in 12 GB and 1 thread
    // completed (the setting a 3,202-sample genome run used).
    //
    // ref_shard_size (bp): the ref_blocks window. One aggregate unit per
    // (chromosome, window) holds ~17 bytes per window base (~340 MB at the
    // 20 Mbp default, per thread). 0 = one window per chromosome (~4 GB on
    // chr1): discouraged. Smaller windows mean more units and more staging
    // commits. Output is identical regardless of value.
    ref_shard_size    = 20000000
    // mosaic aggregate --threads (reduce concurrency). null = task.cpus.
    // It was pinned to 1 (the 3,202-sample genome-wide run's setting; its
    // 4-thread OOM has since been bounded by the Arrow group_by reduce)
    // and then kept at 1 because 4 threads conflicted on Iceberg commits (263
    // conflicts, 14% faster, on the genome x 100 scale test). Since the
    // batched aggregate commits only the main process commits, once per
    // barrier and table: on six chr21 samples as three batches (--fan-in 2
    // --ref-shard-size 2000000, 24 windows) 4 threads went from 12.6-13.4 s
    // and 6 conflicts per run (no gain over 1 thread) to 6.6-6.7 s and 0
    // conflicts (1.6-1.8x over 1 thread); at the CLI defaults 6.5 s vs
    // 7.6-8.1 s at 1 thread, 0 conflicts. Memory at 4 threads above 100
    // samples genome-wide is not re-measured (run 3: 5.5 GB peak at 100).
    aggregate_threads = null
    // AGGREGATE task resources (applied via withName:AGGREGATE on awsbatch).
    // Defaults match the shared 4 vCPU / 12 GiB so AGGREGATE fits the existing
    // compute environment; raise aggregate_memory ONLY alongside a queue whose
    // CE has matching instances -- an oversized request strands the job in
    // RUNNABLE (see conf/awsbatch.config and the memory note below).
    aggregate_cpus    = 4
    aggregate_memory  = 12.GB

    // --- The joint-call workflow (workflow/joint_call.nf). It also reads
    // samples (the sets' names; unset = one set of every active sample),
    // batch_size (the set size: this run's
    // own value, not tied to the ingest batches) and region (chromosome
    // names only; unset = every chromosome with sites). Each null below
    // means joint_call.py's own default.
    //
    // Where the outputs go: <joint_call_out>/gen<agg_run_id>/ (the export,
    // a folder per set, joint_call_summary.tsv). A local path (made
    // absolute) or s3://bucket/prefix; awsbatch sets its own. A second
    // option set (or --batch_size) on the same generation writes over the
    // same files: give it its own joint_call_out.
    joint_call_out              = './joint_calls'
    // --max-alt-alleles: the ALT cap (null = the driver's 6; 0 = none).
    joint_call_max_alt_alleles  = null
    // --trim-alt-alleles: drop the ALTs no written genotype names.
    joint_call_trim_alt_alleles = false
    // --min-ac: write only records with at least this many ALT observations
    // (null = off).
    joint_call_min_ac           = null
    // --window: the unit width in bp (null = 10 Mbp). The output does not
    // depend on it.
    joint_call_window           = null
    // --threads (null = the task's cpus). Lower it (or raise
    // joint_call_memory, with a compute environment that has such
    // instances) for a large set: a set's memory grows with the data files
    // it reads.
    joint_call_threads          = null
    // Write each VCF's .tbi (bcftools index -t) and check its record count
    // against the driver's.
    joint_call_index            = true
    // Chromosome exports in flight: the only load the workflow puts on
    // PostgreSQL. The local profile runs one at a time.
    joint_call_export_forks     = 2
    // JOINT_CALL tasks in flight (null = the profile's limit: 30 on
    // awsbatch, 1 under the local profile, which keeps it).
    joint_call_max_forks        = null
    // A JOINT_CALL task's resources, as ingestion's.
    joint_call_cpus             = 4
    joint_call_memory           = 12.GB
}

// Defaults that both profiles share. Profiles may override.
process {
    cpus          = 4
    // Static across retries — the CE only has 4 vCPU / 16 GiB instances
    // (~12 GiB usable after ECS reservation), so scaling on retry stalls
    // the job forever in RUNNABLE with
    // MISCONFIGURATION:JOB_RESOURCE_REQUIREMENT.
    memory        = 12.GB
    disk          = { 500.GB * task.attempt }
    time          = '10d'
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries    = 3

    // A hung ingest becomes a failed task (and a retry) instead of an idle
    // instance. The hang it catches: a shard worker dies (2026-11-05, run 3's
    // chrM: a segfault in a fork-inherited AWS SDK object, since fixed by
    // spawning the workers), vcflib's Sharder cannot notice, and the task
    // waits forever -- nothing logged after `Created N shard(s)`, the
    // instance's dmesg showing `python ... segfault`. July's longest
    // INGEST_BATCH (chr1, 200 samples) took 10 h.
    withName: INGEST_BATCH {
        time = '36h'
    }

    // The joint-call workflow (joint_call.nf), by label (a withLabel
    // selector that matches no process is silent, so main.nf's runs print
    // no "no process matching config selector" warning for these). The four
    // processes that run joint_call.py (label jc_driver) stop the run on its
    // exit status 2 (a refusal: a stale cohort, a bad sample name or option,
    // a changed cohort under --export-contig), which fails the same way on
    // a retry; any other failure retries as the defaults do, 137 / 140 / 143
    // (OOM, spot interruption) included as under awsbatch. A selector's
    // strategy holds under a profile's generic one.
    withLabel: jc_driver {
        errorStrategy = { task.exitStatus == 2 ? 'terminate'
                          : (task.exitStatus in [137, 140, 143] || task.attempt <= 3
                             ? 'retry' : 'finish') }
    }
    // EXPORT_CONTIG.
    withLabel: jc_export_contig {
        maxForks = params.joint_call_export_forks
    }
    // JOINT_CALL.
    withLabel: jc_call {
        cpus   = params.joint_call_cpus
        memory = params.joint_call_memory
        time   = '24h'
        // Only when set: else the profile's limit applies (a null here
        // would lift it).
        if (params.joint_call_max_forks) {
            maxForks = params.joint_call_max_forks
        }
    }
}

profiles {
    local    { includeConfig 'conf/local.config'    }
    awsbatch { includeConfig 'conf/awsbatch.config' }
}

// Execution report/trace — always on; cheap and very useful for
// debugging retries.
def ts = new java.util.Date().format('yyyyMMdd-HHmmss')
report   { enabled = true; file = "reports/report-${ts}.html"   }
timeline { enabled = true; file = "reports/timeline-${ts}.html" }
trace    { enabled = true; file = "reports/trace-${ts}.txt"     }
